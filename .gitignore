# Byte-compiled / optimized Python files
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
venv/
.venv/
ENV/

# Environment variables
.env
.env.local

# Node (web app)
node_modules/
.next/
dist/
build/

# Test coverage
.coverage
htmlcov/
.pytest_cache/

# OS
.DS_Store
Thumbs.db

# Logs
*.log
logs/

# SQLite DB (datos locales)
*.db
*.sqlite
*.sqlite3

# Resultados temporales del worker
/tmp/charter_results/

# IDE
.idea/
.vscode/
*.swp
*.swo

# Resultados de documentos
*.pdf
*.docx
*.html        # Gantt exportado (en docs/ sí se versiona)
!.github/

# Backup directories (created by agent restores — never commit)
charter-app.*-backup/
charter-app.bak/
charter-app.GIT-HUB-*/
charter-app.SWARM-PROFESSIONAL-*/

# SQLite WAL files (excluded at root level — charter-app/ has its own .gitignore)
*.db-shm
*.db-wal
